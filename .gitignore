# Python environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw data (NAB benchmark files pulled locally via scripts/fetch_data.sh, not
# redistributed here) and processed derivatives
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated figures. Scratch analysis plots stay local and are regenerated by
# the src/analysis scripts. The two README figures are committed so GitHub
# renders them.
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/nyc_taxi_before_after.png
!reports/figures/six_series_comparison.png

# Credentials and secrets
*.env
.env
secrets.yaml
*_secret*
*.key
kaggle.json
.kaggle/

# Tooling
.pytest_cache/
.DS_Store
